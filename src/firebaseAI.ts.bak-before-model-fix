import { initializeApp, getApps, getApp } from 'firebase/app';
import { initializeAppCheck, ReCaptchaEnterpriseProvider } from 'firebase/app-check';
import { getAI, getGenerativeModel, GoogleAIBackend, InferenceMode } from 'firebase/ai';

type Mode = 'hybrid' | 'local' | 'cloud';

let appCheckInitialized = false;

const config = {
  apiKey: import.meta.env.VITE_FIREBASE_API_KEY,
  authDomain: import.meta.env.VITE_FIREBASE_AUTH_DOMAIN,
  projectId: import.meta.env.VITE_FIREBASE_PROJECT_ID,
  appId: import.meta.env.VITE_FIREBASE_APP_ID,
  messagingSenderId: import.meta.env.VITE_FIREBASE_MESSAGING_SENDER_ID
};

export function isFirebaseConfigured(): boolean {
  return Boolean(config.apiKey && config.projectId && config.appId && import.meta.env.VITE_APPCHECK_SITE_KEY);
}

function requireFirebase() {
  if (!isFirebaseConfigured()) {
    throw new Error('Connect your own Firebase project and App Check site key before running real AI. See README.');
  }
  const app = getApps().length ? getApp() : initializeApp(config);
  if (!appCheckInitialized) {
    // Debug tokens are developer credentials: never include them in production builds.
    if (import.meta.env.DEV && import.meta.env.VITE_ENABLE_APP_CHECK_DEBUG === 'true') {
      (globalThis as typeof globalThis & { FIREBASE_APPCHECK_DEBUG_TOKEN?: boolean }).FIREBASE_APPCHECK_DEBUG_TOKEN = true;
    }
    initializeAppCheck(app, {
      provider: new ReCaptchaEnterpriseProvider(import.meta.env.VITE_APPCHECK_SITE_KEY),
      isTokenAutoRefreshEnabled: true
    });
    appCheckInitialized = true;
  }
  return app;
}

/** Invoked ONLY from a user click so Chrome's on-device model initialization has user activation. */
export async function generateAnalysis(
  prompt: string,
  mode: Mode,
  onProgress: (fraction: number) => void
): Promise<{ text: string; source: string }> {
  const app = requireFirebase();
  const ai = getAI(app, { backend: new GoogleAIBackend() });
  const inferenceMode = mode === 'local'
    ? InferenceMode.ONLY_ON_DEVICE
    : mode === 'cloud' ? InferenceMode.ONLY_IN_CLOUD : InferenceMode.PREFER_ON_DEVICE;
  const model = getGenerativeModel(ai, { mode: inferenceMode });
  if (mode !== 'cloud') {
    // Start model initialization immediately on the user's click, before awaiting anything.
    const initialization = model.initializeDeviceModel(onProgress);
    if (mode === 'local') {
      await initialization; // Local-only must wait for Gemini Nano before inferencing.
    } else {
      // Hybrid may fall back to cloud while the model is still downloading.
      void initialization.catch(() => {});
    }
  }
  const result = await model.generateContent(prompt);
  const responseText = result.response.text().trim();
  if (!responseText) throw new Error('The model returned an empty response.');
  return {
    text: responseText,
    source: result.response.inferenceSource ?? 'UNREPORTED'
  };
}
