# These Firebase web-app configuration values identify the Firebase app; they are not server API secrets.
# DO NOT put Google Cloud service account keys, debug App Check tokens, or private Gemini API keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Your public reCAPTCHA Enterprise site key. Register it in Firebase App Check.
VITE_APPCHECK_SITE_KEY=
# Set true only in local development; never use in a production build.
VITE_ENABLE_APP_CHECK_DEBUG=false
